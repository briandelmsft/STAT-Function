{
    "version": "2.0",
    "logging": {
        "applicationInsights": {
            "samplingSettings": {
                "isEnabled": true,
                "excludedTypes": "Request"
            }
        }
    },
    "extensionBundle": {
        "id": "Microsoft.Azure.Functions.ExtensionBundle",
        "version": "[4.0.0, 5.0.0)"
    },
    "extensions": {
        "mcp": {
            "instructions": "The Microsoft Sentinel Triage AssistanT is used to triage Sentinel data and provide insights to analysts and threat hunters",
            "serverName": "MicrosoftSentinelTriageAssistant",
            "serverVersion": "2.0.0",
            "encryptClientState": true,
            "messageOptions": {
                "useAbsoluteUriForEndpoint": false
            },
            "system": {
                "webhookAuthorizationLevel": "System"
            }
        }
    }
}